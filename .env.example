# Copy this file to .env.local and fill in real values.
# NOT needed today: Spendly currently runs fully on localStorage.
# These are for the planned Supabase backend (see docs/BACKEND_INTEGRATION_PLAN.md).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# NEVER put the Supabase service_role key in a VITE_ variable:
# anything prefixed VITE_ is bundled into the public frontend.
